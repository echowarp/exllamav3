+namespace FLASH_NAMESPACE {
+template<int kNWarps>
+using TiledMmaH16 = cute::TiledMMA<cute::MMA_Atom<cute::SM80_16x8x16_F16F16F16F16_TN>,
+                                   cute::Layout<cute::Shape<cute::Int<kNWarps>, cute::_1, cute::_1>>,
+                                   cute::Tile<cute::Int<16 * kNWarps>, cute::_16, cute::_16>>;
+// FA16_PV 1: P.V of one KV block in fp16 MMA accumulate, added into the fp32 acc_o (fp16 only over kBlockN keys).
+template<int kNWarps, typename AccO, typename TP, typename TV, typename SV, typename CopyV, typename ThrV>
+__forceinline__ __device__ void pv_gemm(AccO &acc_o, TP &tOrP, TV &tOrVt, SV const &tOsVt, CopyV cv, ThrV tv, int tidx) {
+#if FA16_PV == 1
+    TiledMmaH16<kNWarps> mh;
+    Tensor acc_h = make_fragment_like<cutlass::half_t>(acc_o);
+    clear(acc_h);
+    gemm_rs(acc_h, tOrP, tOrVt, tOsVt, mh, cv, tv);
+    #pragma unroll
+    for (int i = 0; i < size(acc_o); ++i) acc_o(i) += float(acc_h(i));
+#elif FA16_PV == 2
+    TiledMmaH16<kNWarps> mh;
+    gemm_rs(acc_o, tOrP, tOrVt, tOsVt, mh, cv, tv);
+#endif
+}
+}  // namespace FLASH_NAMESPACE
+
+namespace FLASH_NAMESPACE {
+// FA16_QK 2: Q.K in fp16 MMA accumulate over 64 head dims (4 k-steps), flushed into the fp32 acc_s (fp16 sums of 64 terms).
+template<bool A_in_regs, int kNWarps, typename Tensor0, typename Tensor1, typename Tensor2, typename Tensor3, typename Tensor4,
+         typename TiledCopyA, typename TiledCopyB, typename ThrCopyA, typename ThrCopyB>
+__forceinline__ __device__ void gemm_qk_chunk(Tensor0 &acc, Tensor1 &tCrA, Tensor2 &tCrB, Tensor3 const& tCsA,
+                            Tensor4 const& tCsB, TiledCopyA smem_tiled_copy_A, TiledCopyB smem_tiled_copy_B,
+                            ThrCopyA smem_thr_copy_A, ThrCopyB smem_thr_copy_B) {
+    TiledMmaH16<kNWarps> mh;
+    Tensor acc_h = make_fragment_like<cutlass::half_t>(acc);
+    Tensor tCrA_copy_view = smem_thr_copy_A.retile_D(tCrA);
+    Tensor tCrB_copy_view = smem_thr_copy_B.retile_D(tCrB);
+    if (!A_in_regs) { cute::copy(smem_tiled_copy_A, tCsA(_, _, _0{}), tCrA_copy_view(_, _, _0{})); }
+    cute::copy(smem_tiled_copy_B, tCsB(_, _, _0{}), tCrB_copy_view(_, _, _0{}));
+    #pragma unroll
+    for (int i = 0; i < size<2>(tCrA); ++i) {
+        if (i < size<2>(tCrA) - 1) {
+            if (!A_in_regs) { cute::copy(smem_tiled_copy_A, tCsA(_, _, i + 1), tCrA_copy_view(_, _, i + 1)); }
+            cute::copy(smem_tiled_copy_B, tCsB(_, _, i + 1), tCrB_copy_view(_, _, i + 1));
+        }
+        if (i % 4 == 0) clear(acc_h);
+        cute::gemm(mh, tCrA(_, _, i), tCrB(_, _, i), acc_h);
+        if (i % 4 == 3) {
+            #pragma unroll
+            for (int j = 0; j < size(acc); ++j) acc(j) += float(acc_h(j));
+        }
+    }
+}
+}  // namespace FLASH_NAMESPACE
