# exl3cuda attention / KV-cache mode: int4 KV (int4_per_token_head)
#
# Use:   docker run --env-file exl3cuda/configs/int4.env ...      or   set -a; . exl3cuda/configs/int4.env; set +a
# vLLM:  --kv-cache-dtype int4_per_token_head --attention-backend TRITON_ATTN --dtype float16
#        (the plugin patches vLLM's Triton attention backend; VA4 needs fp16 queries)
# Build: python3 csrc/va/build.py          -> lib/va5090.so   (VA; loaded with VA4)
#        python3 csrc/va4/build.py -DHPV -DLZT=0.f  -> lib/va4c.so   (VA4; the measured build: fp16-accumulate P.V,
#                   eager rescale; kernel 1.55x the int8 VA kernel at 64-196k. Without flags: fp32 P.V, lazy rescale)
#        python3 csrc/kvw4/build.py        -> lib/kvw4.so     (KVW4)
#        csrc/fa16: ./fetch_and_patch.sh; python3 build.py fa_f 1 2  -> lib/fa_f/   (FA16 f, used by the I4FA prefill)
#        Paths are relative to exl3cuda/; outputs land in exl3cuda/lib/, where the plugin looks by default.
# Shape: the VA / VA4 / I4FA kernels are specialised for 24 query heads, 4 KV heads, head size 256, fp16
#        (Qwen3.8-27B attention layers) and sm_120 (RTX 5090). Other shapes fall back to vLLM's stock int4 path.
#
# Measured (RTX 5090, Qwen3.8-27B EXL3 4.0 bpw, MTP k = 7; vs the int8.env mode on the same engine):
#   KV capacity 1.88x (479,954 vs 254,803 tokens at the same memory budget).
#   Single-stream decode steps/s: +14-16 % at 128k-190k context, +3.5-6 % at 48-64k, unchanged at 8k.
#   Replayed coding-agent traffic (16-34k contexts, 1 stream): decode +11.6 % tok/s.
#   Quality: teacher-forced KL vs an fp16-KV reference on generated agent tokens 0.0044 (int8.env mode 0.0013, so
#   +0.0031); top-1 96.5 %; without K smoothing (KS4) 0.0051. EXL3 4.0 bpw weights alone: 0.016 vs BF16.
#   Trade-off: KV blocks are 3,200 tokens (int8: 1,664) because the attention page must match the GDN state page,
#   so prefix-cache hits are coarser: short shared prefixes (< 3,200 tokens) are recomputed.
#   Stock vLLM int4 attention (no VA4) is 30-60x slower than VA4 at verify shapes: do not use int4 KV without it.
#
# Each variable: what it does; values; code default. Lines starting with '#' are left at the code default.

# Master switch for the plugin's attention patches (VA, VA4, I4FA and the FA2 prefill route all live under it).
# 1 = on, 0 = stock vLLM attention everywhere. Default 1.
EXL3_INT8KV_FA=1

# VA: custom CUDA verify / decode attention kernel; with int4 KV it enables VA4 (the int8 kernel itself stays idle).
# 1 = on, 0 = Triton. Default 0.
EXL3_VA=1

# VA4: int4 verify / decode attention (<= 8 query rows per sequence): pre-rotated int8 q, int8 tensor-core Q.K,
# fp16 P.V, un-rotating merge. Needs EXL3_VA=1. 1 = on, 0 = stock int4 Triton. Default 1.
EXL3_VA4=1

# VA4 op namespace (the TORCH_LIBRARY name in the built library). va4c = csrc/va4/va4c_kernel.cu. Default va4c.
EXL3_VA4_OP=va4c

# VA4 library path. Any path to a va4c build. Default <package>/lib/va4c.so.
#EXL3_VA4_SO=

# VA library path (loaded before VA4). Default <package>/lib/va5090.so.
#EXL3_VA_SO=

# VA / VA4 CTA-segments per KV head and sequence (one wave on the RTX 5090's 170 SMs); batches with more sequences
# than this use Triton. Integer >= 1. Default 42.
#EXL3_VA_WAVE=42

# VA4-PSEUDO: prefills of up to this many rows run through VA4 as 8-row pseudo-sequences (exact causal mask) instead
# of I4FA. Integer, 0 = off. Default 64.
EXL3_VA4_PREFILL_Q=64

# Query rows per request treated as decode / verify (VA / VA4 path; more rows = prefill path). Set to MTP depth k + 1
# (k = 7 -> 8); VA / VA4 handle at most 8. Integer. Default 8.
EXL3_VERIFY_Q=8

# I4FA: int4 prefill = gather-dequant of the paged int4 cache to fp16 + rotated q + FA2 (or FA16) + LSE merge.
# 1 = on, 0 = stock int4 Triton prefill (slow; its fp32 temporaries can run out of memory at 8 x 4k prompts). Default 1.
EXL3_I4FA=1

# I4-PLAN: build the int4 mixed-step attention row plan once per step from host copies (no per-layer syncs).
# 1 = on, 0 = per-layer path. Default 1.
EXL3_I4PLAN=1

# Context tokens dequantized per FA2 call in I4FA (parts merged by log-sum-exp). Integer. Default 32768.
EXL3_INT8KV_KB=32768

# FA16: route the prefill FA2 calls to the fp16-accumulate FlashAttention 2 build. f = P.V and Q.K fp16-accumulate,
# b = P.V only, empty = stock FA2 (vLLM's). Default empty. Numerics change (not bitwise); measured quality equal to
# stock FA2 vs BF16, mixed steps -5 % time per prefill token. Needs the csrc/fa16 build.
EXL3_FA16=f

# Directory holding the FA16 module directories fa_f/ and fa_b/. Default <package>/lib.
#EXL3_FA16_DIR=

# KVW4: fused int4 KV-cache write (one kernel instead of vLLM's RHT + quantize; 97 % byte-equal to stock, error equal
# or lower). 1 = on, 0 = stock write. Default 1.
EXL3_KVW4=1

# KVW4 library path. Default <package>/lib/kvw4.so.
#EXL3_KVW4_SO=

# K smoothing table: store K - mean (per layer / KV head / channel) in the KV cache; softmax is unchanged and the
# int4 / int8 range is no longer eaten by channel outliers. Path to a .pt table made with EXL3_KSMOOTH_CALIB (see the
# README: "Data files you supply"; calibrate with the int8.env mode). Unset = off. Default unset.
#EXL3_KSMOOTH=

# KS4: apply the EXL3_KSMOOTH table to int4 KV as well (it is always applied to int8). 1 = on, 0 = int8 only.
# Default 1.
EXL3_KSMOOTH_INT4=1

# MIX-3D: decode / verify rows of mixed (prefill + decode) steps use the split-softmax 3D Triton kernel.
# 1 = on, 0 = 2D kernel. Default 1.
EXL3_MIX3D=1
