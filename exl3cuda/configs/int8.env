# exl3cuda attention / KV-cache mode: int8 KV (int8_per_token_head)
#
# Use:   docker run --env-file exl3cuda/configs/int8.env ...      or   set -a; . exl3cuda/configs/int8.env; set +a
# vLLM:  --kv-cache-dtype int8_per_token_head --attention-backend TRITON_ATTN --dtype float16
#        (the plugin patches vLLM's Triton attention backend; VA needs fp16 queries)
# Build: python3 csrc/va/build.py          -> lib/va5090.so   (VA)
#        csrc/fa16: ./fetch_and_patch.sh; python3 build.py fa_f 1 2  -> lib/fa_f/   (FA16 f)
#        csrc/i8fa: python3 build.py i8kv; python3 build.py i8fa_fp 1 2  -> lib/i8kv/, lib/i8fa_fp/   (I8FA;
#                   i8fa_fp needs the fa16 fetch first; with EXL3_FA16 unset build i8fa_a 0 0 instead)
#        Paths are relative to exl3cuda/; outputs land in exl3cuda/lib/, where the plugin looks by default.
# Shape: the VA / I8FA kernels are specialised for 24 query heads, 4 KV heads, head size 256, fp16 (Qwen3.8-27B
#        attention layers) and sm_120 (RTX 5090). Other shapes fall back to vLLM's stock int8 path.
#
# Measured (RTX 5090, Qwen3.8-27B EXL3 4.0 bpw, MTP k = 7):
#   KV capacity: 254,803 tokens at the reference memory budget (int4.env: 1.88x that).
#   VA vs Triton verify attention: +17 % / +21 % decode steps/s at 128k / 190k context, decode-logprob KL within
#   run-to-run noise. I8FA: cold prefill -3.1 to -3.6 % time (bitwise equal output). FA16 f: mixed steps -5 % time
#   per prefill token, quality equal to stock FA2 vs BF16. MIX-3D: +11.7 % on an 8-agent replay.
#   Quality: teacher-forced KL vs an fp16-KV reference on generated agent tokens 0.0013, top-1 98.8 %. Prompt NLL on
#   agent prompts with int8 KV + K smoothing: +0.51 % (vLLM's int8 KV without smoothing: +1.14 %; measured with
#   the same KV format on the sibling XPU plugin).
#   EXL3 4.0 bpw weights alone: KL 0.016 vs BF16. Prefix-cache blocks: 1,664 tokens.
#
# What to change from the defaults (= configs/int4.env on an sm_120 GPU): only the vLLM flag
# --kv-cache-dtype int8_per_token_head. The int8 features below are already on by default on sm_120 (VA, FA16, I8FA;
# K smoothing needs your table) and the int4-only ones go idle with an int8 cache, so every value below equals the
# default; the file documents them and pins them. Build csrc/i8fa (not needed for int4).
# Each variable: what it does; values; code default ("x on sm_120, else y" where it depends on the GPU).
# Lines starting with '#' are left at the code default.
# The int4-only variables (EXL3_VA4*, EXL3_I4FA, EXL3_I4PLAN, EXL3_KVW4*, EXL3_KSMOOTH_INT4) have no effect here.

# Master switch for the plugin's attention patches (VA and the FA2 prefill route below).
# 1 = prefill rows (> EXL3_VERIFY_Q per request) on block-dequantized FA2 instead of Triton unified attention;
# 0 = stock vLLM attention everywhere. Default 1.
EXL3_INT8KV_FA=1

# Context tokens dequantized per FA2 call (parts merged by log-sum-exp). Integer. Default 32768.
EXL3_INT8KV_KB=32768

# VA: custom CUDA verify / decode attention (<= 8 query rows per sequence) on the int8 cache. 1 = on, 0 = Triton.
# Default 1 on sm_120, else 0.
EXL3_VA=1

# VA library path. Default <package>/lib/va5090.so.
#EXL3_VA_SO=

# VA CTA-segments per KV head and sequence (one wave on the RTX 5090's 170 SMs); batches with more sequences than this
# use Triton. Integer >= 1. Default 42.
#EXL3_VA_WAVE=42

# Query rows per request treated as decode / verify (VA path; more rows = FA2 prefill path). Set to MTP depth k + 1
# (k = 7 -> 8); VA handles at most 8. Integer. Default 8.
EXL3_VERIFY_Q=8

# FA16: route the prefill FA2 calls to the fp16-accumulate FlashAttention 2 build. f = P.V and Q.K fp16-accumulate,
# b = P.V only, empty = stock FA2 (vLLM's). Default f on sm_120, else empty. Numerics change (not bitwise). Needs the csrc/fa16 build.
EXL3_FA16=f

# Directory holding the FA16 module directories fa_f/ and fa_b/. Default <package>/lib.
#EXL3_FA16_DIR=

# I8FA: CUDA gather-dequant + LSE merge around the same FA2 calls (bitwise equal), plus a paged in-kernel-dequant FA2
# for few query rows over long contexts. 1 = on, 0 = torch dequant / merge. Default 1 on sm_120, else 0. Needs the csrc/i8fa build.
EXL3_I8FA=1

# I8FA paged route: auto = queries of <= 128 rows with >= 3 key parts, N = queries of <= N rows, 0 = off.
# Default auto.
EXL3_I8FA_PAGED_MAXQ=auto

# Directory holding i8kv/, i8fa_fp/, i8fa_a/. Default <package>/lib.
#EXL3_I8FA_DIR=

# K smoothing table: store K - mean (per layer / KV head / channel) in the int8 cache; softmax is unchanged and the
# per-token int8 range is no longer eaten by channel outliers (attention sinks). Path to a .pt table. Unset = off.
# Default unset. Make one with EXL3_KSMOOTH_CALIB (README: "Data files you supply").
#EXL3_KSMOOTH=

# K smoothing calibration: with an eager engine (--enforce-eager) and this mode, accumulate key means of real tokens
# and save {layer: mean[H, D]} to this path every 64 calls. Calibration runs only; unset for serving. Default unset.
#EXL3_KSMOOTH_CALIB=

# Calibration ignores token-heads whose key norm exceeds 3x the median (attention sinks). 1 = on, 0 = plain mean.
# Default 1.
#EXL3_KSMOOTH_ROBUST=1

# MIX-3D: decode / verify rows of mixed (prefill + decode) steps use the split-softmax 3D Triton kernel.
# 1 = on, 0 = 2D kernel. Default 1.
EXL3_MIX3D=1
